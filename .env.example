# Catálogo de filmes e séries
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=

# Catálogo esportivo. A chave pública 123 da TheSportsDB é usada se esta
# variável ficar vazia; uma chave própria aumenta a quantidade de eventos.
SPORTSDB_API_KEY=123

# Opcional: habilita transmissões e destaques oficiais incorporáveis do ScoreBat.
# Cadastre uma chave em https://www.scorebat.com/video-api/
SCOREBAT_API_TOKEN=

# Banco e autenticação
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_CONNECT_TIMEOUT_MS=10000
PORT=3000
FLIXA_COOKIE_SECURE=0

# Recuperação de senha (envio via Resend)
# URL pública sem barra final, usada nos links enviados por e-mail.
FLIXA_PUBLIC_URL=https://flixa.run
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=Flixa <conta@flixa.run>
