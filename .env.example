# Catálogo de filmes e séries
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=

# Catálogo esportivo. A chave 123 é pública e documentada pela TheSportsDB.
SPORTSDB_API_KEY=123

# Opcional: habilita transmissões e destaques oficiais incorporáveis do ScoreBat.
SCOREBAT_API_TOKEN=

# Fontes oficiais extras, associadas pelo ID do evento (nunca pelo título).
# Provedores aceitos: YouTube, ScoreBat, Twitch, Dailymotion e Vimeo.
# Exemplo fictício: [{"eventId":"sportsdb-123456","url":"https://www.twitch.tv/canal_oficial","label":"Canal oficial"}]
SPORTS_AUTHORIZED_EMBEDS_JSON=[]

# Alternativa escalável ao JSON acima. O endpoint HTTPS deve devolver o mesmo array.
SPORTS_AUTHORIZED_EMBEDS_URL=

# Banco e autenticação
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_CONNECT_TIMEOUT_MS=10000
PORT=3000

# Em produção o cookie é sempre Secure. Em desenvolvimento, deixe vazio para autodetecção.
FLIXA_COOKIE_SECURE=

# Segredo independente para Watch Party. Não reutilize senha do banco ou chave de outro serviço.
WATCH_PARTY_SECRET=

# Recuperação de senha (envio via Resend)
# URL pública sem barra final, usada nos links enviados por e-mail.
FLIXA_PUBLIC_URL=https://flixa.run
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=Flixa <conta@flixa.run>
