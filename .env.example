# Credenciais do servidor. Nunca preencha este arquivo com valores reais.
# Opções públicas ficam em config/app.json e lib/miniseries/settings.ts.

# Banco: conexão privada necessária para autenticação e persistência.
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Filmes e séries: use uma das credenciais TMDB.
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=

# Minisséries Syln: token com o IP de saída do servidor autorizado no painel Syln.
SYLN_TOKEN=


# Credencial para usar Assistir Junto.
ABLY_API_KEY=

# Credencial para enviar recuperação de senha por e-mail.
RESEND_API_KEY=

# Segredo para atualização por cron/script. O painel usa a sessão administrativa.
MINISERIES_REFRESH_SECRET=
