# Catálogo de filmes e séries
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=

# Streamed não requer chave. TheSportsDB permanece para os demais esportes. A chave pública 123 da TheSportsDB é usada se esta
# variável ficar vazia; uma chave própria aumenta a quantidade de eventos.
SPORTSDB_API_KEY=123

# Fontes oficiais extras, associadas pelo ID do evento (nunca pelo título).
# Provedores aceitos: YouTube, Twitch, Dailymotion e Vimeo.
# Exemplo: [{"eventId":"sportsdb-123456","url":"https://www.twitch.tv/canal_oficial","label":"Canal oficial"}]
SPORTS_AUTHORIZED_EMBEDS_JSON=[]

# Alternativa escalável ao JSON acima. O endpoint HTTPS deve devolver o mesmo array.
SPORTS_AUTHORIZED_EMBEDS_URL=

# Banco e autenticação
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_CONNECT_TIMEOUT_MS=10000
PORT=3000
FLIXA_COOKIE_SECURE=0

# Recuperação de senha (envio via Resend)
# URL pública sem barra final, usada nos links enviados por e-mail.
FLIXA_PUBLIC_URL=https://flixa.run
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=Flixa <conta@flixa.run>

# Assistir em grupo: chave Ably apenas no servidor. A chave precisa permitir
# publish/subscribe/presence/history em watch-party:* (incluindo os canais :chat).
ABLY_API_KEY=
# Segredo próprio para assinar sessões de sala (recomendado).
WATCH_PARTY_SECRET=
