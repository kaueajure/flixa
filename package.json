{
  "name": "flixa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "vite",
    "build": "vinext build",
    "build:sites": "bash scripts/build-verified.sh",
    "start": "node server.cjs",
    "start:vinext": "vinext start",
    "start:esm": "node server.js",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "miniseries:smoke": "node --experimental-strip-types scripts/smoke-miniseries.mjs",
    "dramabox:smoke": "node scripts/smoke-dramabox.mjs",
    "miniseries:refresh": "node scripts/refresh-miniseries.mjs",
    "miniseries:verify-storage": "node scripts/verify-miniseries-storage.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "postinstall": "node scripts/patch-dramabox.mjs",
    "prebuild": "node scripts/patch-dramabox.mjs",
    "syln:dramabox:smoke": "node scripts/smoke-syln-dramabox.mjs",
    "reelshort:smoke": "node scripts/smoke-reelshort.mjs"
  },
  "dependencies": {
    "@zhadev/dramabox": "0.0.2",
    "ably": "^2.27.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "0.45.2",
    "hls.js": "^1.7.3",
    "mysql2": "^3.23.3",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vinext": "0.0.50"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "dotenv": "^17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Flixa"
}
